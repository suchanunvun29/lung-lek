# ==========================================
# Backend (.NET 9) Environment Variables (.env)
# ==========================================

# 1. Supabase PostgreSQL Connection String
# Pooler (Port 6543) หรือ Direct (Port 5432)
# ตัวอย่าง: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# 2. JWT Secret Key (อย่างน้อย 32 ตัวอักษร)
JWT_SECRET=your-super-secret-jwt-key-at-least-32-chars-long

# 3. Google Gemini API Key (สำหรับระบบ AI Coaching & Analysis)
GEMINI_API_KEY=your-gemini-api-key-here

# 4. ASP.NET Core Configurations
ASPNETCORE_ENVIRONMENT=Development
PORT=4000
ASPNETCORE_URLS=http://+:4000

# 5. CORS Allowed Origins (comma-separated, wildcard supported e.g. https://*.vercel.app, or *)
ALLOWED_ORIGINS=https://*.vercel.app,http://localhost:3000
